# Option A: point to an existing private file. Secrets are never copied.
# MONGODB_ENV_FILE=C:/path/to/atlas-credentials.env
# Option B: inject MONGODB_URI through the process environment/secret manager.
# Rotate any previously shared password before attempting live access.
# MONGODB_URI=mongodb+srv://<db_username>:<URL_ENCODED_PASSWORD>@<atlas-host>/
MONGODB_DATABASE=climate_hazard_analyzer
MONGODB_TIMEOUT_MS=5000

WEATHER_PRIMARY_PROVIDER=nasa_power
WEATHER_FALLBACK_PROVIDERS=open_meteo
# Enable only for a deployment whose usage meets Open-Meteo's free terms.
WEATHER_FALLBACK_ENABLED=false
OPEN_METEO_NONCOMMERCIAL_USE=false
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIME_STANDARD=UTC
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_MODEL=era5
WEATHER_PROVIDER_TIMEOUT_SECONDS=10
WEATHER_PROVIDER_MAX_RETRIES=1
WEATHER_TOTAL_TIMEOUT_SECONDS=60
WEATHER_MIN_COVERAGE_PERCENT=95
